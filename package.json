{
  "name": "poc-cypress-e2e",
  "version": "1.0.0",
  "description": "POC - Cypres Interface and Service Tests",
  "main": "index.js",
  "scripts": {
    "build:lint": "npx eslint --format html --output-file ./eslint-report.html",
    "build:prettier:check": "npx prettier . --check",
    "build:prettier:format": "npx prettier . --write",
    "start": "npx cypress open",
    "test": "npx cypress run --browser chrome",
    "stop": "npm stop",
    "test:api": "npm run test -- --expose grepTags=@api",
    "test:web": "npm run test -- --expose grepTags=@web",
    "test:debug": "npm run test -- --expose grepTags=@debug"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arthurboeck/poc-cypress-e2e.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@brazilian-utils/brazilian-utils": "^2.3.0",
    "@cypress/grep": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "cypress": "^15.14.2",
    "eslint": "^10.0.3",
    "eslint-plugin-cypress": "^6.2.0",
    "eslint-plugin-mocha": "^11.2.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1"
  }
}
